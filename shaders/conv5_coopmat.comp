#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 192) in;

#ifndef SCOPE_SUBGROUP
#define SCOPE_SUBGROUP 1
#endif
#if SCOPE_SUBGROUP
#define CM_SCOPE gl_ScopeSubgroup
#else
#define CM_SCOPE gl_ScopeWorkgroup
#endif

layout(constant_id = 0) const int CIN = 16;
layout(constant_id = 1) const int COUT = 16;
layout(constant_id = 2) const int COUT_R = 16;
layout(constant_id = 3) const int LAST = 0;
layout(constant_id = 4) const int KS = 144;
layout(constant_id = 5) const int KP = 160;
layout(constant_id = 6) const int BST = 160;
layout(constant_id = 7) const int BM = 256;

const int W = 796;
const int H = 360;
const int HW = H * W;
const int NT = COUT / 8;
const int NSTEP = KP / 32;
const int BST4 = BST / 4;

layout(std430, binding = 0) readonly buffer InBuf { int32_t ain32[]; };
layout(std430, binding = 1) buffer Out8Buf { int8_t y8[]; };
layout(std430, binding = 2) readonly buffer WBuf { int8_t wgt[]; };
layout(std430, binding = 3) readonly buffer BQBuf { int bq[]; };
layout(std430, binding = 4) readonly buffer MBuf { float mult[]; };
layout(std430, binding = 5) buffer OutFBuf { float fout[]; };

shared i8vec4 As[2 * BM * 8];
shared int8_t Bs[COUT * BST];
shared int accs[BM * COUT];

void stage_tile(int tid, int row0, int gk0base, int bufbase, int step) {
    int row = row0;
    int p = row / W;
    int q = row % W;
    for (int j = 0; j < 2; ++j) {
        int gk0 = gk0base + step * 32 + j * 16;
        bool valid = row < HW && gk0 < KS;
        int rs = gk0 / CIN;
        int c0 = gk0 % CIN;
        int h = p + rs / 3 - 1;
        int w = q + rs % 3 - 1;
        bool inb = valid && h >= 0 && h < H && w >= 0 && w < W;
        int dst = (bufbase / 32) * 8 + tid * 8 + j * 4;
        int32_t w0 = 0, w1 = 0, w2 = 0, w3 = 0;
        if (inb) {
            int b4 = ((h * W + w) * CIN + c0) / 4;
            w0 = ain32[b4 + 0];
            w1 = ain32[b4 + 1];
            w2 = ain32[b4 + 2];
            w3 = ain32[b4 + 3];
        }
        As[dst + 0] = i8vec4(int8_t(w0), int8_t(w0 >> 8), int8_t(w0 >> 16), int8_t(w0 >> 24));
        As[dst + 1] = i8vec4(int8_t(w1), int8_t(w1 >> 8), int8_t(w1 >> 16), int8_t(w1 >> 24));
        As[dst + 2] = i8vec4(int8_t(w2), int8_t(w2 >> 8), int8_t(w2 >> 16), int8_t(w2 >> 24));
        As[dst + 3] = i8vec4(int8_t(w3), int8_t(w3 >> 8), int8_t(w3 >> 16), int8_t(w3 >> 24));
    }
}

void main() {
    int tid = int(gl_LocalInvocationID.x);
    int wg = int(gl_WorkGroupID.x);

    for (int i = tid; i < COUT * BST; i += 192) {
        int k = i / BST;
        int gk = i % BST;
        Bs[i] = gk < KS ? wgt[gk * COUT + k] : int8_t(0);
    }

    int row0 = wg * BM + tid;
    int sg = tid / 32;
    int sbase = sg * 32;

    stage_tile(tid, row0, 0, 0, 0);
    barrier();

    coopmat<int, CM_SCOPE, 16, 8, gl_MatrixUseAccumulator> acc[NT * 2];
    for (int i = 0; i < NT * 2; ++i)
        acc[i] = coopmat<int, CM_SCOPE, 16, 8, gl_MatrixUseAccumulator>(0);

    for (int ks = 0; ks < NSTEP; ++ks) {
        int32_t nr[8];
        bool have = ks + 1 < NSTEP;
        if (have) {
            int p = row0 / W;
            int q = row0 % W;
            for (int j = 0; j < 2; ++j) {
                int gk0 = (ks + 1) * 32 + j * 16;
                bool valid = row0 < HW && gk0 < KS;
                int rs = gk0 / CIN;
                int c0 = gk0 % CIN;
                int h = p + rs / 3 - 1;
                int w = q + rs % 3 - 1;
                bool inb = valid && h >= 0 && h < H && w >= 0 && w < W;
                if (inb) {
                    int b4 = ((h * W + w) * CIN + c0) / 4;
                    nr[j * 4 + 0] = ain32[b4 + 0];
                    nr[j * 4 + 1] = ain32[b4 + 1];
                    nr[j * 4 + 2] = ain32[b4 + 2];
                    nr[j * 4 + 3] = ain32[b4 + 3];
                } else {
                    nr[j * 4 + 0] = 0;
                    nr[j * 4 + 1] = 0;
                    nr[j * 4 + 2] = 0;
                    nr[j * 4 + 3] = 0;
                }
            }
        }

        int buf = ks & 1;
        coopmat<int8_t, CM_SCOPE, 16, 32, gl_MatrixUseA> amat0, amat1;
        coopmat<int8_t, CM_SCOPE, 32, 8, gl_MatrixUseB> bmat[NT];

        coopMatLoad(amat0, As, uint(buf * BM * 8 + sbase * 8), 8u, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(amat1, As, uint(buf * BM * 8 + (sbase + 16) * 8), 8u, gl_CooperativeMatrixLayoutRowMajor);
        for (int ni = 0; ni < NT; ++ni)
            coopMatLoad(bmat[ni], Bs, uint(ni * 8 * BST + ks * 32), uint(BST),
                        gl_CooperativeMatrixLayoutColumnMajor);

        for (int ni = 0; ni < NT; ++ni) {
            acc[ni * 2 + 0] = coopMatMulAdd(amat0, bmat[ni], acc[ni * 2 + 0]);
            acc[ni * 2 + 1] = coopMatMulAdd(amat1, bmat[ni], acc[ni * 2 + 1]);
        }

        if (have) {
            int dst = ((ks + 1) & 1) * BM * 8 + tid * 8;
            for (int t = 0; t < 8; ++t) {
                int32_t v = nr[t];
                As[dst + t] = i8vec4(int8_t(v), int8_t(v >> 8), int8_t(v >> 16), int8_t(v >> 24));
            }
        }
        barrier();
    }

    for (int ni = 0; ni < NT; ++ni) {
        coopMatStore(acc[ni * 2 + 0], accs, uint(sbase * COUT + ni * 8), uint(COUT),
                     gl_CooperativeMatrixLayoutRowMajor);
        coopMatStore(acc[ni * 2 + 1], accs, uint((sbase + 16) * COUT + ni * 8), uint(COUT),
                     gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();

    for (int i = tid; i < BM * COUT; i += 192) {
        int r = i / COUT;
        int k = i % COUT;
        if (k >= COUT_R) continue;
        int gr = wg * BM + r;
        if (gr >= HW) continue;
        int v = accs[r * COUT + k] + bq[k];
        if (LAST != 0) {
            fout[gr * COUT_R + k] = float(v) * mult[k];
        } else {
            int y = int(roundEven(float(v) * mult[k]));
            y = clamp(y, 0, 127);
            y8[gr * COUT_R + k] = int8_t(y);
        }
    }
}






